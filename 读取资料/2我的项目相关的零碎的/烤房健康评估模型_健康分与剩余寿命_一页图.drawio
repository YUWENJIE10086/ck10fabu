        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=19;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;③ 检查与评价&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;部件检查评价 C_eval、整栋人工评价 E&lt;/span&gt;" vertex="1">
          <mxGeometry height="105" width="285" x="65" y="500" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=19;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;④ 管护与维修&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;管护方式 M、维修动作、维修完成年、费用记录&lt;/span&gt;" vertex="1">
