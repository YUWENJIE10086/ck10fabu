        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#24537A;strokeColor=#24537A;strokeWidth=1;fontColor=#FFFFFF;fontSize=15;fontFamily=Microsoft YaHei;fontStyle=1;align=center;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="当前年份作为统一计算基准" vertex="1">
          <mxGeometry height="42" width="285" x="65" y="748" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4F81BD;strokeWidth=2;fontColor=#23313F;fontSize=21;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;① 计算部件剩余年限&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(35, 49, 63);&quot;&gt;已用年限 = 当前年 − max（建成年，最近维修完工年）&lt;br&gt;remainingᵢ = max〔0，（指导寿命 − 已用年限）×S_status〕&lt;br&gt;状态系数：正常1.0 · 异常0.7 · 损坏0.3 · 缺失0&lt;/span&gt;" vertex="1">
          <mxGeometry height="155" width="608" x="435" y="255" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#6750A4;strokeWidth=2;fontColor=#23313F;fontSize=21;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;② 计算单个部件健康分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(35, 49, 63);&quot;&gt;R_remain = remainingᵢ ÷ 指导寿命&lt;br&gt;scoreᵢ = 100 ×（0.50S_status + 0.35R_remain +0.15C_eval）&lt;br&gt;C_eval：优良/好1.0 · 差0.5 · 缺省0.8&lt;/span&gt;" vertex="1">
          <mxGeometry height="155" width="631" x="410" y="430" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#2F7D61;strokeWidth=2;fontColor=#23313F;fontSize=21;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;③ 部件归一化与风险排序&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(35, 49, 63);&quot;&gt;contributionᵢ = weightᵢ × scoreᵢ ÷ 100&lt;br&gt;P_norm = Σcontributionᵢ ÷ Σweightᵢ × 100&lt;br&gt;按健康缺口×部件重要度排序，提取风险部位TOP3&lt;/span&gt;" vertex="1">
          <mxGeometry height="155" width="585" x="435" y="605" as="geometry" />
        </mxCell>
        <mxCell id="24" edge="1" parent="1" source="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F81BD;strokeWidth=3;dashed=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5C6B78;labelBackgroundColor=#FFFFFF;" target="22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="25" edge="1" parent="1" source="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6750A4;strokeWidth=3;dashed=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5C6B78;labelBackgroundColor=#FFFFFF;" target="23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="26" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#2F7D61;strokeWidth=3;fontColor=default;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=1;opacity=100;" value="&lt;b&gt;&lt;span&gt;④ 整栋健康分 H&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;&lt;b&gt;H = 0.80P_norm + 0.10M + 0.10E&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;M：集中管护100 · 分户管护80&lt;br&gt;E：好100 · 中80 · 差50&lt;br&gt;结果限定在0—100分&lt;/span&gt;" vertex="1">
          <mxGeometry height="230" width="340" x="1110" y="255" as="geometry" />
        </mxCell>
        <mxCell id="27" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#6750A4;strokeWidth=3;fontColor=default;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=1;opacity=100;" value="&lt;b&gt;&lt;span&gt;⑤ 整栋剩余寿命 life&lt;/span&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;&lt;b&gt;life = clamp〔（0.60×短板寿命&lt;br&gt;＋0.40×部件加权平均寿命）×F_h，0，15〕&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;F_h = clamp（0.75＋H/400，0.60，1.10）&lt;br&gt;预计退役年 = 当前年＋ceil（life）&lt;/span&gt;" vertex="1">
          <mxGeometry height="250" width="340" x="1110" y="520" as="geometry" />
        </mxCell>
        <mxCell id="28" edge="1" parent="1" source="26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2F7D61;strokeWidth=4;dashed=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5C6B78;labelBackgroundColor=#FFFFFF;" target="27" value="健康分校准">
