        <mxCell id="16" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;b&gt;&lt;font&gt;① 烤房基础数据&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;&lt;font&gt;健康分、容量、使用状态、所在村&lt;/font&gt;&lt;/span&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="264" x="63" y="255" as="geometry" />
