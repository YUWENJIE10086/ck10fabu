          <mxGeometry height="96" width="264" x="63" y="365" as="geometry" />
        </mxCell>
        <mxCell id="18" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;font&gt;&lt;b&gt;③ 村级发展数据&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;&quot;&gt;规模增长、管护缴费、政策、服务、韧性&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="264" x="63" y="475" as="geometry" />
        </mxCell>
        <mxCell id="19" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font&gt;④ 候选点数据&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;地形、水文、电力、交通、烟田匹配等8项指标&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="264" x="63" y="585" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#24537A;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font&gt;⑤ 专家判断参数&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;AHP两两比较矩阵、组合系数α（默认0.6）&lt;/span&gt;" vertex="1">
          <mxGeometry height="96" width="264" x="63" y="695" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4F81BD;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;① 有效烤能折算&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;单栋 Eᵢ = 健康分/100 × capacityKg × 状态系数（默认5000 kg/座）&lt;br&gt;状态系数：在用1.0 · 闲置0.4 · 损毁/待修0.1 · 其他0&lt;br&gt;村级 Q = 0.70×在用A + 0.20×闲置B + 0.10×待修C&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="650" x="400" y="250" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#4F81BD;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;② 理论需求与承载匹配&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;D = 收购量kg（担×50）；缺失时按面积×capacityKg÷20&lt;br&gt;Hc = min（100，Q/D×100）　P = D÷max（Q，1）&lt;br&gt;Lc：P≤0.85→100 · ≤1.00→85 · ≤1.20→70 · ≤1.50→50 · 其他30&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="650" x="400" y="395" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#6750A4;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;③ 发展指数与需求分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;Dc = 规模增长、管护缴费、政策争取、服务能力、扩张韧性综合得分&lt;br&gt;&lt;b&gt;V = 0.50Hc + 0.30Lc + 0.20Dc&lt;/b&gt;&lt;br&gt;&lt;b&gt;需求分 N = 100 − V&lt;/b&gt;（N越低，表示新建需求越迫切）&lt;/span&gt;" vertex="1">
          <mxGeometry height="125" width="650" x="400" y="535" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FBF3E5;strokeColor=#C7923E;strokeWidth=2;fontColor=#000000;fontSize=20;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;④ 推荐栋数与新增推演&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;loadBefore = 收购kg ÷（在用栋数×capacityKg）&lt;br&gt;needBarns = ceil（loadBefore − 1.0）&lt;br&gt;Q′ = Q＋新增栋数×capacityKg → 重算V′；改善值 ΔV = V′−V&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="630" x="410" y="680" as="geometry" />
        </mxCell>
        <mxCell id="25" edge="1" parent="1" source="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4F81BD;strokeWidth=3;dashed=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5C6B78;labelBackgroundColor=#FFFFFF;" target="22" value="">
