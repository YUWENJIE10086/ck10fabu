          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="27" edge="1" parent="1" source="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C7923E;strokeWidth=3;dashed=0;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#5C6B78;labelBackgroundColor=#FFFFFF;" target="24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="28" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#2F7D61;strokeWidth=2;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;⑤ 八项指标量化&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;对每个候选点的地形、水文、电力、交通、烟田匹配、环境安全、集群效益和成本经济进行统一评分。&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="345" x="1130" y="255" as="geometry" />
        </mxCell>
        <mxCell id="29" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#F3EFFA;strokeColor=#6750A4;strokeWidth=2;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;⑥ 主客观组合赋权&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;AHP两两比较 → 主观权重 W主观&lt;br&gt;熵权法计算信息差异 → 客观权重 W客观&lt;br&gt;&lt;b style=&quot;&quot;&gt;W = αW主观＋（1−α）W客观&lt;/b&gt;（α默认0.6）&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="145" width="345" x="1130" y="410" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#52A36C;strokeWidth=2;fontColor=#000000;fontSize=18;fontFamily=Microsoft YaHei;fontStyle=0;align=left;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;⑦ TOPSIS候选点排序&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;构建加权评价矩阵 → 确定正、负理想解&lt;br&gt;计算候选点与理想解的距离&lt;br&gt;&lt;b style=&quot;&quot;&gt;贴近度 Cᵢ 越大，候选点综合适宜性越高&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="345" x="1130" y="580" as="geometry" />
