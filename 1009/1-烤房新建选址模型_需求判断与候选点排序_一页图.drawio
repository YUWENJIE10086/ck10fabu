        <mxCell id="15" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=16;fillColor=#C7923E;strokeColor=#C7923E;strokeWidth=1;fontColor=#FFFFFF;fontSize=22;fontFamily=Microsoft YaHei;fontStyle=0;align=center;verticalAlign=middle;spacing=10;spacingLeft=10;spacingRight=10;spacingTop=6;dashed=0;shadow=0;opacity=100;" value="&lt;b&gt;&lt;font style=&quot;font-size: 23px;&quot;&gt;决策输出&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;形成可执行的新建建议&lt;/span&gt;" vertex="1">
